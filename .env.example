# =============================================================================
# Hinthar SMS — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
#   cp .env.example .env
# =============================================================================

# --- Database ---
# For local Docker dev, this is overridden by docker-compose.yml.
# For production (Render), set this to your Neon connection string.
DATABASE_URL=postgres://hinthar:hinthar_local_pass@localhost:5432/hinthar_sms

# --- Django ---
SECRET_KEY=change-me-to-a-real-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Clerk Auth ---
CLERK_FRONTEND_API=https://your-clerk-frontend-api.clerk.accounts.dev
CLERK_JWKS_URL=https://your-clerk-frontend-api.clerk.accounts.dev/.well-known/jwks.json
CLERK_SECRET_KEY=sk_live_your_clerk_secret_key
# Optional: set if your Clerk JWT template / session token includes an aud claim
# CLERK_JWT_AUDIENCE=

# Session token must include identity claims (Clerk Dashboard → Sessions → Customize session token):
#   { "email": "{{user.primary_email_address}}", "username": "{{user.username}}" }
# Also enable Username under User & authentication if you want real Clerk usernames.
