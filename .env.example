# =============================================================================
# Hinthar SMS — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
#   cp .env.example .env
# =============================================================================

# --- Database ---
# For local Docker dev, this is overridden by docker-compose.yml.
# For production (Render), set this to your Neon connection string.
DATABASE_URL=postgres://hinthar:hinthar_local_pass@localhost:5432/hinthar_sms

# --- Django ---
SECRET_KEY=change-me-to-a-real-secret-key
# Fail closed: production must set DEBUG=False (default if unset is False).
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Local Next.js origins. Leave empty in production and set your real frontend origin(s).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# --- Clerk Auth ---
CLERK_FRONTEND_API=https://your-clerk-frontend-api.clerk.accounts.dev
CLERK_JWKS_URL=https://your-clerk-frontend-api.clerk.accounts.dev/.well-known/jwks.json
CLERK_SECRET_KEY=sk_live_your_clerk_secret_key
# Issuer verified on every JWT (defaults to CLERK_FRONTEND_API if unset)
# CLERK_JWT_ISSUER=https://your-clerk-frontend-api.clerk.accounts.dev
# Required when DEBUG=False — bind tokens to this API
CLERK_JWT_AUDIENCE=

# Local-only mock auth: requires DEBUG=True AND ENABLE_MOCK_AUTH=true
# Authorization: Bearer mock_token_<suffix>
ENABLE_MOCK_AUTH=true

# Optional shared cache for JWKS / stats across workers (PERF-M6)
# REDIS_URL=redis://localhost:6379/0

# Session token must include identity claims (Clerk Dashboard → Sessions → Customize session token):
#   { "email": "{{user.primary_email_address}}", "username": "{{user.username}}", "aud": "hinthar-sms-api" }
# Also enable Username under User & authentication if you want real Clerk usernames.
